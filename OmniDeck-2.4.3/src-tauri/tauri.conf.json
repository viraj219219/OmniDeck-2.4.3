{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniDeck",
  "version": "2.4.3",
  "identifier": "org.omnideck.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "OmniDeck",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/media/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/libreoffice/**/*": "resources/libreoffice/"
    },
    "category": "Education",
    "shortDescription": "Sunday School lesson builder and classroom presenter",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "both"
      }
    },
    "license": "LicenseRef-Proprietary",
    "copyright": "Copyright \u00a9 2026 OmniDeck. All rights reserved.",
    "publisher": "OmniDeck"
  }
}
